<Window x:Class="HotelReservations.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Хотел – резервации на стаи" Height="560" Width="860"
        MinHeight="460" MinWidth="700"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="8">

        <!-- ================= Резервации ================= -->
        <TabItem Header="Резервации">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Label DockPanel.Dock="Left" Content="Филтър:"/>
                        <Button DockPanel.Dock="Right" Content="Изчисти филтъра" Margin="8,3,0,3" Click="ReservationFilterClear_Click"/>
                        <DatePicker x:Name="FilterToPicker" DockPanel.Dock="Right" Width="120"
                                    SelectedDateChanged="ReservationDateFilter_Changed"/>
                        <Label DockPanel.Dock="Right" Content="до:"/>
                        <DatePicker x:Name="FilterFromPicker" DockPanel.Dock="Right" Width="120"
                                    SelectedDateChanged="ReservationDateFilter_Changed"/>
                        <Label DockPanel.Dock="Right" Content="Период от:" Margin="8,0,0,0"/>
                        <TextBox x:Name="ReservationFilter" TextChanged="ReservationFilter_TextChanged"
                                 ToolTip="Търси по клиент, номер или тип на стаята"/>
                    </DockPanel>
                <DataGrid x:Name="ReservationsGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False"
                          SelectionChanged="ReservationsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер" Binding="{Binding RoomNumber}" Width="80"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding RoomType}" Width="130"/>
                        <DataGridTextColumn Header="Цена (€/нощ)" Binding="{Binding RoomPrice, StringFormat=F2}" Width="110"/>
                        <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="*"/>
                        <DataGridTextColumn Header="Настаняване" Binding="{Binding CheckIn, StringFormat=dd.MM.yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Освобождаване" Binding="{Binding CheckOut, StringFormat=dd.MM.yyyy}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Стая:"/>
                    <ComboBox x:Name="ReservationRoomCombo" Grid.Row="0" Grid.Column="1"
                              DisplayMemberPath="Display" SelectedValuePath="Id"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Клиент:"/>
                    <TextBox x:Name="ClientTextBox" Grid.Row="1" Grid.Column="1" MaxLength="100"/>

                    <Label Grid.Row="0" Grid.Column="3" Content="Настаняване:"/>
                    <DatePicker x:Name="CheckInPicker" Grid.Row="0" Grid.Column="4"/>

                    <Label Grid.Row="1" Grid.Column="3" Content="Освобождаване:"/>
                    <DatePicker x:Name="CheckOutPicker" Grid.Row="1" Grid.Column="4"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Добави" Click="AddReservation_Click"/>
                    <Button Content="Промени" Click="UpdateReservation_Click"/>
                    <Button Content="Изтрий" Click="DeleteReservation_Click"/>
                    <Button Content="Изчисти" Click="ClearReservation_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ================= Стаи ================= -->
        <TabItem Header="Стаи">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Label DockPanel.Dock="Left" Content="Филтър:"/>
                        <Button DockPanel.Dock="Right" Content="Изчисти филтъра" Margin="8,3,0,3" Click="RoomFilterClear_Click"/>
                        <TextBox x:Name="RoomFilter" TextChanged="RoomFilter_TextChanged"
                                 ToolTip="Търси по номер или тип на стаята"/>
                    </DockPanel>
                <DataGrid x:Name="RoomsGrid"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" CanUserAddRows="False"
                          SelectionChanged="RoomsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="100"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="*"/>
                        <DataGridTextColumn Header="Цена (€/нощ)" Binding="{Binding Price, StringFormat=F2}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Content="Номер:"/>
                    <TextBox x:Name="RoomNumberTextBox" Grid.Column="1" MaxLength="10"/>

                    <Label Grid.Column="3" Content="Тип:"/>
                    <ComboBox x:Name="RoomTypeCombo" Grid.Column="4" IsEditable="True">
                        <ComboBoxItem Content="Единична"/>
                        <ComboBoxItem Content="Двойна"/>
                        <ComboBoxItem Content="Тройна"/>
                        <ComboBoxItem Content="Апартамент"/>
                    </ComboBox>

                    <Label Grid.Column="6" Content="Цена (€):"/>
                    <TextBox x:Name="RoomPriceTextBox" Grid.Column="7"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Добави" Click="AddRoom_Click"/>
                    <Button Content="Промени" Click="UpdateRoom_Click"/>
                    <Button Content="Изтрий" Click="DeleteRoom_Click"/>
                    <Button Content="Изчисти" Click="ClearRoom_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
